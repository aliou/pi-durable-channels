{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["@aliou/biome-plugins/configs/base"],
  "files": {
    "includes": ["**/*.ts", "**/*.json"],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": ["packages/channels/src/types.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConfusingVoidType": "off"
          }
        }
      }
    }
  ]
}
