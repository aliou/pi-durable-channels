#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "Configuring direnv"
if [ ! -f .envrc ]; then
  printf 'use flake\n' > .envrc
fi
direnv allow

# Keep .direnv (flake symlinks) out of git and biome's scan; local to this clone.
if ! grep -qx '.direnv' .git/info/exclude 2>/dev/null; then
  echo '.direnv' >> .git/info/exclude
fi

echo "Installing dependencies"
direnv exec . pnpm install --frozen-lockfile
