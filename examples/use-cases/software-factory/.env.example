# provider/modelId; the provider's own key variable must be set too (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# faux/faux-1 runs a scripted model without a key.
MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# The repository the factory works on, as owner/name, and its base branch.
GITHUB_REPO=
BASE_BRANCH=main
# Optional: clone URL, default https://github.com/<GITHUB_REPO>.git
REPO_URL=
# A GitHub App installed on the repository, with Contents, Issues, and Pull requests read/write, and Actions read.
# Its ID, and the path of its private key (.pem). The factory finds the installation by itself.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# Or a classic token of the factory's own account with the public_repo scope (repo for private repositories).
GITHUB_TOKEN=
# Secret of the repository webhook pointed at /github/webhook.
GITHUB_WEBHOOK_SECRET=
# Labels the triage agent may add, comma-separated.
TRIAGE_LABELS=bug,cannot-reproduce,needs-info,question
# Author of the factory's commits.
FACTORY_GIT_NAME=pi factory
FACTORY_GIT_EMAIL=factory@example.com

# Slack app bot token (scopes in the Slack channel README).
SLACK_BOT_TOKEN=xoxb-
# Socket Mode: an app-level token with connections:write. No public URL needed.
SLACK_APP_TOKEN=xapp-
# Or HTTP events: leave SLACK_APP_TOKEN empty, set the signing secret, and point Event Subscriptions at /slack/events.
SLACK_SIGNING_SECRET=

PORT=8787
DATA_DIR=tmp/software-factory
