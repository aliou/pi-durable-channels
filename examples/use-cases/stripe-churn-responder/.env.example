# provider/modelId; the provider's own key variable must be set too (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# faux/faux-1 runs a scripted model without a key.
MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Signing secret printed by `stripe listen`, or set on the Stripe endpoint. Any value works with the replay script.
STRIPE_WEBHOOK_SECRET=whsec_

# Optional: enables the read-only stripe_get tool. Use a restricted key with read access only.
STRIPE_SECRET_KEY=

# Slack app bot token (scopes in the Slack channel README) and the channel where cases are posted, for example C0123ABC.
SLACK_BOT_TOKEN=xoxb-
SLACK_CHANNEL_ID=

# Socket Mode: an app-level token with connections:write. No public URL needed.
SLACK_APP_TOKEN=xapp-
# Or HTTP events: leave SLACK_APP_TOKEN empty, set the signing secret, and point Event Subscriptions at /slack/events.
SLACK_SIGNING_SECRET=

PORT=8787
DATA_DIR=tmp/stripe-churn-responder
