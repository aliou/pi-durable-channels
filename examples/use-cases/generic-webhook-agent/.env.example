# provider/modelId; the provider's own key variable must be set too (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...).
# faux/faux-1 runs a scripted model without a key.
MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=

# Optional: where pages and notes are posted as JSON { text }, for example a second webhook.site URL.
# Unset, they print to the console.
PAGER_URL=

# Comma-separated origins check_url may request, for example https://status.example.com,https://api.example.com.
# Webhook bodies are untrusted input; keep this to public health endpoints.
CHECK_URL_ORIGINS=

PORT=8787
DATA_DIR=tmp/generic-webhook-agent
